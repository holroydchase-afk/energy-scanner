{
  "name": "energy-scanner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Take or upload a photo of a person and see their energy radiate off them as an animated aura. Runs entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/check-agents.sh && vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "postinstall": "node scripts/copy-mediapipe-wasm.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1"
  }
}
